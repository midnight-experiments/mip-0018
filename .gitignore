# Dependencies and caches
node_modules/
.cache/
*.tsbuildinfo
dist/
coverage/

# Compact compiler output is never committed (decision Q24): builds are deterministic,
# and the verifier-key hashes of every circuit are recorded in docs/costs.json.
managed/

# Local chain stack: generated ports, state and logs (docker/local-stack/)
docker/local-stack/.state/
docker/local-stack/ports.env
*.log

# Wallet material, private state and run records that may hold secrets.
# Secrets live outside the repository (see SECURITY.md); these patterns are a backstop.
*.mnemonic
*.seed
*.secret
*.wallet-cache
.env
.env.*
private/
private-state/

# OS / editor
.DS_Store
.idea/
.vscode/
