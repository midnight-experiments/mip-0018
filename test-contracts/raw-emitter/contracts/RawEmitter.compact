// SPDX-License-Identifier: Apache-2.0
//
// ============================================================================================
//  TEST-ONLY CONTRACT — NOT FOR PRODUCTION. NEVER USE AS AN EXAMPLE.
// ============================================================================================
//
// Emits an ARBITRARY `Misc` name and payload, so a test network can carry MIP-0018 events that a
// conforming consumer must reject (malformed payloads, MIP test R1-R6), ignore (`[v2]` or foreign
// names) or accept at capacity (A2), next to valid ones; `emitTwo` puts two events in one
// transaction (MIP test S7). A real issuer never passes a payload through unchecked: use the
// module in packages/compact, which can only build valid payloads.
//
// Owner-gated with OpenZeppelin Compact Contracts 0.4.0-alpha.5 `Ownable` (owner decision Q4).
// Compile with Compact 0.35.0, --feature-zkir-v3 and --compact-path <repo>/node_modules.

pragma language_version >= 0.26.0;

import CompactStandardLibrary;
import "@openzeppelin/compact-contracts/access/Ownable" prefix Ownable_;
import "@openzeppelin/compact-contracts/utils/Utils" prefix Utils_;

export { Either, ContractAddress };

constructor(initialOwner: Either<Bytes<32>, ContractAddress>) {
  Ownable_initialize(initialOwner);
}

/** Emits Misc { name, payload } exactly as given. Owner only. */
export circuit emitRaw(name: Bytes<32>, payload: Bytes<256>): [] {
  Ownable_assertOnlyOwner();
  emit(Misc { name: disclose(name), payload: disclose(payload) });
}

/** Emits two Misc events in one transaction, in this order. Owner only. */
export circuit emitTwo(name1: Bytes<32>, payload1: Bytes<256>, name2: Bytes<32>, payload2: Bytes<256>): [] {
  Ownable_assertOnlyOwner();
  emit(Misc { name: disclose(name1), payload: disclose(payload1) });
  emit(Misc { name: disclose(name2), payload: disclose(payload2) });
}

/** OpenZeppelin account id of a secret key: persistentHash(secretKey). */
export pure circuit accountId(secretKey: Bytes<32>): Bytes<32> {
  return Utils_computeAccountId(secretKey);
}
