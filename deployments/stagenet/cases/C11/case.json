      },
      {
        "record": "record.json",
        "step": "revive",
        "expect": "expect/revive.json"
      }
    ],
    "list": [
      {
        "record": "record.json",
        "expect": "expected-after-publish.json",
        "atStep": "publish"
      },
      {
        "record": "record.json",
        "expect": "expected-after-withdraw.json",
