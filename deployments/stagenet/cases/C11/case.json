      "expectExit": 0,
      "stdout": "observed-list-after-revive.json"
    }
  ],
  "expected": "expected.json",
  "recheck": {
    "verify": [
      {
        "record": "record.json",
        "step": "publish",
        "expect": "expect/publish.json"
      },
      {
        "record": "record.json",
        "step": "withdraw",
