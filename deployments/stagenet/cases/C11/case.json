      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "withdrawMetadata",
        "--step",
        "withdraw-again",
        "--force"
      ],
      "expectExit": 0,
      "submits": "call",
      "note": "the identity is already gone, so the before-check sees no change and would skip it: --force emits it anyway (vector S3b)"
    },
    {
      "id": "verify-withdraw-again",
      "runner": "wallet-free",
      "argv": [
