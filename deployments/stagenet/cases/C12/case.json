{
  "kind": "mip0018-case",
  "schema": 1,
  "id": "C12",
  "title": "Raw emitter (test-only), C07's contract: image and image_sha256, a key that is not served, name and symbol over their lengths, a 31-byte image_sha256",
  "demonstrates": "MIP-0018 PR #372 on chain, one identity (kind 3, its own domainSep) through C07's owner-gated raw emitter: A6 image (type 4) and a 32-byte image_sha256 (type 0) in one event, both served and usable; S10a a record foo = \"x\" is accepted and not served; S11 a 70-character name and a 15-character symbol (grapheme clusters: combining marks, flags, Hangul L+V+T jamo) are usable and served as their first 64 / 12 characters; S12b a 31-byte image_sha256 is unusable.",
  "conclusion": "after a6: image and image_sha256 usable; after s10a: unchanged (foo is not served); after s11: name and symbol served truncated (the stored bytes are unchanged); after s12b: image_sha256 unusable, the other fields unchanged. C07's identity (0x11…/3) is listed unchanged next to it.",
  "mip": {
    "commit": "338ea194bbe7c4e5d1829234a503b7c1b11ebf0f",
    "eventName": "mip-0018:token-metadata[v1]"
  },
  "source": {
    "contract": "test-contracts/raw-emitter",
    "contractOf": "C07",
    "vectors": "vectors/payload/A6.json, vectors/state/S10a.json, S11a.json, S11b.json, S12b.json"
  },
  "dependsOn": [
    "C07"
  ],
  "notes": [
    "domainSep = pad(32, \"mip-0018:stagenet:C12\"); every event carries the records of the named vector under this header.",
    "`--attach @{out:C07}/record.json` starts this case's own record for C07's contract (C07's record is not touched); wallet 1 is the raw emitter's owner.",
    "--force: s10a leaves the served state unchanged, so the before-check would skip it; --force emits every step.",
    "C07's identity (0x11…/3) is on the same contract: each expected state lists it as C07 left it, and the counts include C07's 22 events."
  ],
  "placeholders": {
    "{net}": "network options (Stagenet: --network stagenet)",
    "{signer}": "wallet 1's signer options (mnemonic file, wallet cache)",
    "{signer2}": "wallet 2's signer options, with its OWN private-state file",
    "{case}": "this case folder",
    "{out}": "where records and observations are written (Stagenet: this case folder)",
    "{out:<ID>}": "another case's output folder"
  },
  "steps": [
    {
      "id": "a6",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--example",
        "raw-emitter",
        "--attach",
        "@{out:C07}/record.json",
        "--record",
        "{out}/record.json",
        "--circuit",
        "emitRaw",
        "--args",
        "@{case}/args/a6.json",
        "--step",
        "a6",
        "--force"
      ],
      "expectExit": 0,
      "submits": "call",
      "note": "vector A6: image (type 4) + 32-byte image_sha256 (type 0): accept"
    },
    {
      "id": "s10a",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
