        "--record",
        "{out}/record.json",
        "--circuit",
        "emitRaw",
        "--args",
        "@{case}/args/s10a.json",
        "--step",
        "s10a",
        "--force"
      ],
      "expectExit": 0,
      "submits": "call",
      "note": "vector S10a: foo = \"x\": accept, not served"
    },
    {
      "id": "s11",
      "runner": "signer",
