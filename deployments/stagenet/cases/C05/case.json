{
  "kind": "mip0018-case",
  "schema": 1,
  "id": "C05",
  "title": "OpenZeppelin NativeShieldedTokenFamily: deploy, mint gold + silver, publish three domains",
  "demonstrates": "Separate identities per domainSep (vector S6) in one contract.",
  "conclusion": "3 kind-1 identities (\"Acme Medals\", \"MEDAL\", 0), one per domain, in one group \"MEDAL\"; three distinct colors.",
  "mip": {
    "commit": "b147c627e1bb15b5d15cc73cf30c2a36afd34dbb",
    "eventName": "mip-0018:token-metadata[v1]"
  },
  "source": {
    "example": "examples/openzeppelin/token-family",
    "metadata": "examples/openzeppelin/token-family/metadata.json"
  },
  "notes": [
    "S3 delta: publishMetadata(domain) is called three times (three transactions); bronze is published but never minted."
  ],
  "placeholders": {
    "{net}": "network options (Stagenet: --network stagenet)",
    "{signer}": "wallet 1's signer options (mnemonic file, wallet cache)",
    "{signer2}": "wallet 2's signer options, with its OWN private-state file",
    "{case}": "this case folder",
    "{out}": "where records and observations are written (Stagenet: this case folder)",
    "{out:<ID>}": "another case's output folder"
  },
  "steps": [
    {
      "id": "deploy",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "deploy",
        "{net}",
        "{signer}",
        "--example",
        "token-family",
        "--record",
        "{out}/record.json"
      ],
      "expectExit": 0,
      "submits": "deploy"
    },
    {
      "id": "mint-gold",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "call",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "mint",
        "--args",
        "[\"0x6d69702d303031383a6578616d706c653a66616d696c793a676f6c6400000000\",{\"bytes\":{\"$signer\":\"coinPublicKey\"}},\"3\",{\"$random\":32}]",
        "--step",
        "mint-gold"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "mint-silver",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "call",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "mint",
        "--args",
        "[\"0x6d69702d303031383a6578616d706c653a66616d696c793a73696c7665720000\",{\"bytes\":{\"$signer\":\"coinPublicKey\"}},\"5\",{\"$random\":32}]",
        "--step",
        "mint-silver"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "publish-gold",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "publishMetadata",
        "--args",
        "[\"0x6d69702d303031383a6578616d706c653a66616d696c793a676f6c6400000000\"]",
        "--step",
        "publish-gold"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "publish-silver",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "publishMetadata",
        "--args",
        "[\"0x6d69702d303031383a6578616d706c653a66616d696c793a73696c7665720000\"]",
        "--step",
        "publish-silver"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "publish-bronze",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "publishMetadata",
        "--args",
        "[\"0x6d69702d303031383a6578616d706c653a66616d696c793a62726f6e7a650000\"]",
        "--step",
        "publish-bronze"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "verify-publish-gold",
      "runner": "wallet-free",
      "argv": [
        "verify",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "publish-gold",
        "--expect",
        "@{case}/expect/publish-gold.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-verify-publish-gold.json"
    },
    {
      "id": "verify-publish-silver",
      "runner": "wallet-free",
      "argv": [
        "verify",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "publish-silver",
        "--expect",
        "@{case}/expect/publish-silver.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-verify-publish-silver.json"
    },
    {
      "id": "verify-publish-bronze",
      "runner": "wallet-free",
      "argv": [
        "verify",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "publish-bronze",
        "--expect",
        "@{case}/expect/publish-bronze.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-verify-publish-bronze.json"
    },
    {
      "id": "list",
      "runner": "wallet-free",
      "argv": [
        "list",
        "{net}",
        "--record",
        "{out}/record.json",
        "--expect",
        "@{case}/expected.json",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-list.json"
    },
    {
      "id": "wallet-status",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "wallet",
        "status",
        "{net}",
        "{signer}",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "wallet-status.json",
      "note": "wallet 1's balances per token type: the minted coin/UTXO color as the wallet SDK sees it (independent of our tokenType code)"
    }
  ],
  "expected": "expected.json",
  "recheck": {
    "verify": [
      {
        "record": "record.json",
        "step": "publish-gold",
        "expect": "expect/publish-gold.json"
      },
      {
        "record": "record.json",
        "step": "publish-silver",
        "expect": "expect/publish-silver.json"
      },
      {
        "record": "record.json",
        "step": "publish-bronze",
        "expect": "expect/publish-bronze.json"
      }
    ],
    "list": [
      {
        "record": "record.json",
        "expect": "expected.json"
      }
    ],
    "colors": [
      {
        "record": "record.json",
        "domainSep": "0x6d69702d303031383a6578616d706c653a66616d696c793a676f6c6400000000",
        "kind": 1,
        "wallet": "wallet-status.json",
        "expectIdentity": {
          "domainSep": "0x6d69702d303031383a6578616d706c653a66616d696c793a676f6c6400000000",
          "kind": 1,
          "colored": true,
          "common": {
            "name": "Acme Medals",
            "symbol": "MEDAL",
            "decimals": 0
          }
        }
      },
      {
        "record": "record.json",
        "domainSep": "0x6d69702d303031383a6578616d706c653a66616d696c793a73696c7665720000",
        "kind": 1,
        "wallet": "wallet-status.json",
        "expectIdentity": {
          "domainSep": "0x6d69702d303031383a6578616d706c653a66616d696c793a73696c7665720000",
          "kind": 1,
          "colored": true,
          "common": {
            "name": "Acme Medals",
            "symbol": "MEDAL",
            "decimals": 0
          }
        }
      }
    ]
  }
}
