        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-list-after-withdraw-again.json"
    },
    {
      "id": "revive",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "setMetadata",
        "--args",
        "[{\"$utf8\":\"Acme Again\"},{\"$utf8\":\"ACMA\"}]",
        "--step",
        "revive"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "verify-revive",
      "runner": "wallet-free",
      "argv": [
        "verify",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "revive",
        "--expect",
        "@{case}/expect/revive.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-verify-revive.json"
    },
    {
      "id": "list-after-revive",
      "runner": "wallet-free",
      "argv": [
        "list",
        "{net}",
        "--record",
        "{out}/record.json",
        "--expect",
        "@{case}/expected-after-revive.json",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-list-after-revive.json"
    }
  ],
  "expected": "expected.json",
  "recheck": {
    "verify": [
      {
        "record": "record.json",
        "step": "publish",
        "expect": "expect/publish.json"
      },
      {
        "record": "record.json",
        "step": "rename",
        "expect": "expect/rename.json"
      },
      {
        "record": "record.json",
        "step": "withdraw",
        "expect": "expect/withdraw.json"
      },
      {
        "record": "record.json",
        "step": "withdraw-again",
        "expect": "expect/withdraw-again.json"
      },
      {
        "record": "record.json",
        "step": "revive",
        "expect": "expect/revive.json"
      }
    ],
    "list": [
      {
        "record": "record.json",
        "expect": "expected-after-publish.json",
        "atStep": "publish"
      },
      {
        "record": "record.json",
        "expect": "expected-after-rename.json",
        "atStep": "rename"
      },
      {
        "record": "record.json",
        "expect": "expected-after-withdraw.json",
        "atStep": "withdraw"
      },
      {
        "record": "record.json",
        "expect": "expected-after-withdraw-again.json",
        "atStep": "withdraw-again"
      },
      {
        "record": "record.json",
        "expect": "expected-after-revive.json",
        "atStep": "revive"
      },
      {
        "record": "record.json",
        "expect": "expected.json"
      }
    ]
  }
}
