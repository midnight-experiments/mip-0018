{
  "kind": "mip0018-case",
  "schema": 1,
  "id": "C04",
  "title": "One asset in kinds 1, 2, 3 (OpenZeppelin NativeShieldedToken + FungibleToken, std-lib unshielded): deploy, three mints, publish",
  "demonstrates": "Symbol grouping on chain (vector S9): three identities under one domainSep and symbol form one group; kinds 1 and 2 share one color.",
  "conclusion": "3 identities (\"Acme Dollar\", \"ACD\", 2) in ONE group \"ACD\"; kinds 1 and 2 colored (same color), kind 3 not.",
  "mip": {
    "commit": "274a84f221bcfc17e4b73e2c8b32fd8c028ea092",
    "eventName": "mip-0018:token-metadata[v1]"
  },
  "source": {
    "example": "examples/openzeppelin/multi-kind",
    "metadata": "examples/openzeppelin/multi-kind/metadata.json"
  },
  "notes": [
    "The three identities are published by ONE publishMetadata() transaction with three events."
  ],
  "placeholders": {
    "{net}": "network options (Stagenet: --network stagenet)",
    "{signer}": "wallet 1's signer options (mnemonic file, wallet cache)",
    "{signer2}": "wallet 2's signer options, with its OWN private-state file",
    "{case}": "this case folder",
    "{out}": "where records and observations are written (Stagenet: this case folder)",
    "{out:<ID>}": "another case's output folder"
  },
  "steps": [
    {
      "id": "deploy",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "deploy",
        "{net}",
        "{signer}",
        "--example",
        "multi-kind",
        "--record",
        "{out}/record.json"
      ],
      "expectExit": 0,
      "submits": "deploy"
    },
    {
      "id": "mint-shielded",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "call",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "mintShielded",
        "--args",
        "[{\"bytes\":{\"$signer\":\"coinPublicKey\"}},\"100000\",{\"$random\":32}]",
        "--step",
        "mint-shielded"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "mint-unshielded",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "call",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "mintUnshielded",
        "--args",
        "[{\"bytes\":{\"$signer\":\"unshieldedAddress\"}},\"100000\"]",
        "--step",
        "mint-unshielded"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "mint-ledger",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "call",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "mintLedger",
        "--args",
        "[{\"$adapter\":\"ownerAccount\"},\"100000\"]",
        "--step",
        "mint-ledger"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "publish",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "publishMetadata",
        "--step",
        "publish"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "verify-publish",
      "runner": "wallet-free",
      "argv": [
        "verify",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "publish",
        "--expect",
        "@{case}/expect/publish.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-verify-publish.json"
    },
    {
      "id": "list",
      "runner": "wallet-free",
      "argv": [
        "list",
        "{net}",
        "--record",
        "{out}/record.json",
        "--expect",
        "@{case}/expected.json",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-list.json"
    },
    {
      "id": "wallet-status",
      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "wallet",
        "status",
        "{net}",
        "{signer}",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "wallet-status.json",
      "note": "wallet 1's balances per token type: the minted coin/UTXO color as the wallet SDK sees it (independent of our tokenType code)"
    }
  ],
  "expected": "expected.json",
  "recheck": {
    "verify": [
      {
        "record": "record.json",
        "step": "publish",
        "expect": "expect/publish.json"
      }
    ],
    "list": [
      {
        "record": "record.json",
        "expect": "expected.json"
      }
    ],
    "colors": [
      {
        "record": "record.json",
        "domainSep": "0x6d69702d303031383a6578616d706c653a6d756c74692d6b696e640000000000",
        "kind": 1,
        "wallet": "wallet-status.json",
        "expectIdentity": {
          "domainSep": "0x6d69702d303031383a6578616d706c653a6d756c74692d6b696e640000000000",
          "kind": 1,
          "colored": true,
          "common": {
            "name": "Acme Dollar",
            "symbol": "ACD",
            "decimals": 2
          }
        }
      },
      {
        "record": "record.json",
        "domainSep": "0x6d69702d303031383a6578616d706c653a6d756c74692d6b696e640000000000",
        "kind": 2,
        "wallet": "wallet-status.json",
        "expectIdentity": {
          "domainSep": "0x6d69702d303031383a6578616d706c653a6d756c74692d6b696e640000000000",
          "kind": 2,
          "colored": true,
          "common": {
            "name": "Acme Dollar",
            "symbol": "ACD",
            "decimals": 2
          }
        }
      }
    ]
  }
}
