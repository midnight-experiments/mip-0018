      "runner": "signer",
      "wallet": "wallet1",
      "argv": [
        "publish",
        "{net}",
        "{signer}",
        "--record",
        "{out}/record.json",
        "--circuit",
        "publishMetadata",
        "--step",
        "publish"
      ],
      "expectExit": 0,
      "submits": "call"
    },
    {
      "id": "check-event-publish",
      "runner": "wallet-free",
      "argv": [
        "check-event",
        "{net}",
        "--record",
        "{out}/record.json",
        "--step",
        "publish",
        "--expect",
        "@{case}/expect/publish.json",
        "--wait",
        "120",
        "--json"
      ],
      "expectExit": 0,
      "stdout": "observed-check-event-publish.json"
    },
    {
