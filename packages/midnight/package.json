{
  "name": "@mip0018/midnight",
  "version": "0.1.0",
  "private": true,
  "description": "MIP-0018 chain access for Midnight 2.x: network profiles, node RPC and indexer clients, raw-transaction decoding, token colors, the mint scanner, and (signer entry point) wallet sessions, midnight-js deploy/call with before/after checks.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": "./src/index.ts",
    "./signer": "./src/signer/index.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "fixtures:stagenet": "node test/fixtures/record-stagenet.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-js": "3.0.0-rc.3",
    "@midnight-ntwrk/compact-runtime": "0.20.0",
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0-rc.2",
    "@midnight-ntwrk/midnight-js-types": "5.0.0-rc.2",
    "@midnightntwrk/ledger-v9": "1.0.0-rc.5",
    "@midnightntwrk/wallet-sdk": "2.0.0-beta.2",
    "@mip0018/codec": "0.1.0",
    "@mip0018/consumer": "0.1.0",
    "@scure/bip39": "2.4.0",
    "rxjs": "7.8.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/ws": "8.18.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
