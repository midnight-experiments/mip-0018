// S2a spike (throw-away): individual pure circuits returning bytes, composed
// with Bytes[...] spreads and zero-padded to 256 (no serialize).
pragma language_version >= 0.26.0;

import CompactStandardLibrary;

module P {
  import CompactStandardLibrary;

  export pure circuit header(domainSep: Bytes<32>, kind: Uint<8>): Bytes<33> {
    return Bytes[...domainSep, kind];
  }

  // R = 3 + K + V must be given by the caller; the compiler checks it.
  export pure circuit utf8Record<#K, #V, #R>(key: Bytes<K>, value: Bytes<V>): Bytes<R> {
    return Bytes[K, ...key, 1, V, ...value];
  }

  export pure circuit uintRecord<#K, #R>(key: Bytes<K>, value: Uint<8>): Bytes<R> {
    return Bytes[K, ...key, 2, 1, value];
  }

  export pure circuit payload4<#A, #B, #C, #D, #P>(h: Bytes<33>, r1: Bytes<A>, r2: Bytes<B>, r3: Bytes<C>, r4: Bytes<D>): Bytes<256> {
    return Bytes[...h, ...r1, ...r2, ...r3, ...r4, ...default<Bytes<P>>];
  }
}

import P;

export circuit a1Literal(): [] {
  const p = payload4<17, 13, 12, 20, 161>(
    header(pad(32, "\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11"), 3),
    utf8Record<4, 10, 17>("name", "Acme Token"),
    utf8Record<6, 4, 13>("symbol", "ACME"),
    uintRecord<8, 12>("decimals", 6),
    utf8Record<9, 8, 20>("standards", "mip-0004"));
  emit(Misc { name: pad(32, "mip-0018:token-metadata[v1]"), payload: p });
}

export circuit a1Spread(): [] {
  const p: Bytes<256> = Bytes[
    ...header(pad(32, "\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11\x11"), 3),
    ...utf8Record<4, 10, 17>("name", "Acme Token"),
    ...utf8Record<6, 4, 13>("symbol", "ACME"),
    ...uintRecord<8, 12>("decimals", 6),
    ...utf8Record<9, 8, 20>("standards", "mip-0004"),
    ...pad(161, "")];
  emit(Misc { name: pad(32, "mip-0018:token-metadata[v1]"), payload: p });
}

export circuit a1Args(domainSep: Bytes<32>, name: Bytes<10>, symbol: Bytes<4>, decimals: Uint<8>, standards: Bytes<8>): [] {
  const p = payload4<17, 13, 12, 20, 161>(
    header(domainSep, 3),
    utf8Record<4, 10, 17>("name", name),
    utf8Record<6, 4, 13>("symbol", symbol),
    uintRecord<8, 12>("decimals", decimals),
    utf8Record<9, 8, 20>("standards", standards));
  emit(Misc { name: pad(32, "mip-0018:token-metadata[v1]"), payload: disclose(p) });
}
