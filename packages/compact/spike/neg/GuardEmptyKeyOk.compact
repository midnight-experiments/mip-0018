pragma language_version >= 0.26.0;
import CompactStandardLibrary;
struct Rec<#K, #V> { keyLen: Uint<8>; key: Bytes<K>; valType: Uint<8>; valLen: Uint<8>; value: Bytes<V>; }
pure circuit utf8Record<#K, #V>(key: Bytes<K>, value: Bytes<V>): Rec<K, V> {
  const nonEmptyKey = slice<1>(key, 0);
  return Rec<K, V> { keyLen: K, key: key, valType: 1, valLen: V, value: value };
}
export circuit f(): [] { const r = utf8Record<1, 2>("k", "ok"); emit(Misc { name: pad(32, "x"), payload: serialize<[Bytes<32>, Uint<8>, Rec<1, 2>], 256>([pad(32, ""), 3, r]) }); }
